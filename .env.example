# Postgres (laptop via `npm run compose:dev`)
DATABASE_URL="postgresql://atlasnow:atlasnow@localhost:5433/atlasnow?schema=public"

# Session signing — MUST be a long random string on the VPS
AUTH_SECRET="replace-with-long-random-string"

# GA4 public site only (baked at next build). Default in code: G-HY5V8HH3Z1.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-HY5V8HH3Z1"
# Google Ads tag (AW-…). Empty = GA4 only until founder pastes it. Rebuild required.
# NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXX"

# App URL (OAuth redirects + Meta webhook). Must match environment:
# - Local:  http://localhost:3000
# - Prod:   https://atlasnow.co
APP_BASE_URL="http://localhost:3000"

# Compose / VPS
POSTGRES_USER="atlasnow"
POSTGRES_PASSWORD="atlasnow"
POSTGRES_DB="atlasnow"
ATLAS_DOMAIN="atlasnow.co"
CADDY_EMAIL="hello@atlasnow.co"

# WAHA — laptop: http://localhost:3001  |  compose network: http://waha:3000
WAHA_BASE_URL="http://localhost:3001"
WAHA_API_KEY="atlasnow-waha"
# AtlasNow HQ Cloud number for /signup/pending click-to-WA (wa.me). Default = P2P Labs HQ.
# ATLAS_HQ_WHATSAPP="6285863666290"
# Inside Docker, Atlas tells WAHA to POST here (leave unset on laptop npm run dev)
# WAHA_WEBHOOK_BASE="http://atlas:3000"

# --- API credentials ---
# Preferred: Settings → API Configuration (encrypted in DB).
# Env vars below remain as fallbacks when DB fields are empty.

# Google OAuth — Business Profile (agency account)
# Domain: atlasnow.co
# GCP: enable "My Business Account Management API" + "My Business Business Information API"
# OAuth Web client — Authorized redirect URIs (add BOTH):
#   https://atlasnow.co/api/google/oauth/callback
#   http://localhost:3000/api/google/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional override (else derived from APP_BASE_URL). Production VPS:
GOOGLE_REDIRECT_URI="https://atlasnow.co/api/google/oauth/callback"
META_REDIRECT_URI="https://atlasnow.co/api/meta/oauth/callback"
# Facebook Login for Business → Configurations (Connect Meta / Pages + IG only)
META_LOGIN_CONFIG_ID="2295500691270291"
# WhatsApp Embedded Signup v4 (Chat apps). Not the Pages+IG config above.
META_WHATSAPP_ES_CONFIG_ID="1401943948578182"
# Coexistence launch is read at runtime. Exact true, plus a comma-separated workspace list.
# An empty list launches nobody. Leave both unset until one workspace is approved.
# WHATSAPP_COEXISTENCE_ENABLED=true
# WHATSAPP_COEXISTENCE_TENANT_IDS=

# Contact form → hello@atlasnow.co (Google Workspace). Also settable in Settings → API.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="hello@atlasnow.co"
# SMTP_PASS=            # Google App Password, not the Workspace login
# SMTP_FROM="AtlasNow <hello@atlasnow.co>"
# SMTP_TO=                # Deliver Contact mail here. Empty = hello@atlasnow.co. Use a different mailbox than SMTP_USER so Gmail shows Inbox (not only Sent).
# SMTP_SECURE="false"

# Maps fetch: Geocoding + Places (phone/website). Else Nominatim (address only).
# Enable both APIs on the key in Google Cloud.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Change log (AuditEvent + inbox notices). Default 14 days then delete.
# ACTIVITY_RETENTION_DAYS="14"

# Invoice print (Super Admin → Invoice). Optional override. Defaults: BCA 2480707501.
# Legal seller is PT Sorak Digital Media (P2P Labs). PPN off until founder turns it on.
# BILLING_BANK_NAME="BCA"
# BILLING_BANK_ACCOUNT="2480707501"
# BILLING_BANK_HOLDER="PT Sorak Digital Media (P2P Labs) / (Atlas Now)"

# YOLA FUN. Flags stay false until a separate authorization. Do not paste tokens here in chat.
# Canonical names. META_APP_SECRET and META_VERIFY_TOKEN stay on the existing WhatsApp integration.
# YOLA_WA_ACCESS_TOKEN=
# YOLA_WABA_ID=
# YOLA_WA_PHONE_NUMBER_ID=
# YOLA_PUBLISHED_FLOW_ID=
# YOLA_TEMPLATE_NAME=
# XENDIT_CALLBACK_TOKEN=
# YOLA_FLOW_SEND_ENABLED=false
# YOLA_BULK_MARKETING_ENABLED=false
# YOLA_LIVE_PAYMENTS_ENABLED=false
# YOLA_TICKET_LIVE_ISSUANCE_ENABLED=false
# Comma-separated recipient digits. Empty sends to nobody. The +1 555 sender is ignored.
# YOLA_PILOT_ALLOWLIST=
# YOLA_PILOT_LINK_SEND_ENABLED=false
