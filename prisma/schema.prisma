// AtlasNow — agency admin + clients + location master (S2) + branding

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TenantType: AGENCY | CLIENT
// TenantStatus: ACTIVE | INACTIVE | ARCHIVED
// LocationStatus: ACTIVE | INACTIVE | ARCHIVED
// LocationReadiness: DRAFT | PARTIAL | READY | MAPPED | BLOCKED
// SourceType: GOOGLE_BUSINESS_PROFILE | GOOGLE_MAPS | GSC | ADS | WAHA | SOCIAL | REDEMPTION | MANUAL
// Role: SUPER_ADMIN | AGENCY_ADMIN | ANALYST | CLIENT_ADMIN | HQ_MARKETING | HQ_OPS | REGIONAL | BRANCH | VIEWER
// MembershipStatus: ACTIVE | INVITED | DISABLED

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String
  isActive         Boolean   @default(true)
  /// email | google | facebook
  signupMethod     String?
  termsAcceptedAt  DateTime?
  termsVersion     String?
  privacyVersion   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  noticeSeenAt     DateTime?
  memberships      Membership[]
  auditEvents      AuditEvent[] @relation("AuditActor")
  upgradeRequests  AgencyUpgradeRequest[] @relation("UpgradeApplicant")
  supportThreads   SupportThread[]
  broadcastBatches BroadcastBatch[]
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  type         String   @default("CLIENT")
  timezone     String   @default("Asia/Jakarta")
  status       String   @default("ACTIVE")
  loginEnabled Boolean  @default(false)
  /// free | silver | gold | platinum | diamond — Free hard-stops at 2 store outlets.
  plan         String   @default("free")
  industry     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?
  address      String?
  notes        String?
  activatedAt  DateTime?
  /// Inbox image retention. Already applied on production as 20261004143000.
  inboxImageRetentionDays Int @default(30)
  /// Parent agency when type=CLIENT. Null = standalone brand.
  agencyId     String?
  /// Compressed square mark for the public join page (WebP). Upload original; Atlas resizes.
  logoImage    Bytes?
  logoMime     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentAgency    Tenant?  @relation("AgencyBrands", fields: [agencyId], references: [id], onDelete: Restrict)
  managedBrands   Tenant[] @relation("AgencyBrands")
  memberships     Membership[]
  auditEvents     AuditEvent[]
  locations       Location[]
  connectors      Connector[]
  waContacts      WaContact[]
  waConversations WaConversation[]
  upgradeRequests AgencyUpgradeRequest[] @relation("UpgradeClient")
  notices         InboxNotice[]
  loyaltyProgram  LoyaltyProgram?
  loyaltyMembers  LoyaltyMember[]
  loyaltyIntakes  LoyaltyIntake[]
  loyaltyStamps   LoyaltyStamp[]
  loyaltyRedeems      LoyaltyRedemption[]
  birthdayWaSends     LoyaltyBirthdayWaSend[]
  roleMenuConfigs     RoleMenuConfig[]
  supportThreads      SupportThread[]
  broadcastBatches    BroadcastBatch[]
  broadcastSends      BroadcastSend[]
  loyaltyGoEvents     LoyaltyGoEvent[]
  wabaPhones          WabaPhone[]
  commerceProducts    CommerceProduct[]
  commerceVariants    CommerceVariant[]
  commerceOutlets     CommerceProductOutlet[]
  commerceCatalogLinks CommerceCatalogLink[]
  commerceSyncLogs    CommerceSyncLog[]
  commerceReadiness   CommerceReadiness?
  commerceConnection  CommerceConnection?
  commerceVariantMaps CommerceVariantMap[]
  commerceSyncJobs    CommerceSyncJob[]
  commerceOAuthNonces CommerceOAuthNonce[]
  commerceOrders      CommerceOrder[]
  yolaCustomers       YolaCustomer[]
  yolaSessions        YolaFlowSession[]
  yolaOrders          YolaOrder[]
  yolaPaymentSessions YolaPaymentSession[]
  yolaPaymentEvents   YolaPaymentEvent[]
  yolaTickets         YolaTicket[]
  yolaRedemptions     YolaRedemption[]
  yolaAutomationEvents YolaAutomationEvent[]
  yolaOutboundMessages YolaOutboundMessage[]
  yolaOrderDaySeqs    YolaOrderDaySeq[]
  workspaceAutomation WorkspaceAutomation?
  whatsAppNumberAutomations WhatsAppNumberAutomation[]

  @@index([type, status])
  @@index([agencyId])
  @@index([type, agencyId])
}

model AgencyUpgradeRequest {
  id               String    @id @default(cuid())
  clientId         String
  applicantUserId  String
  status           String    @default("PENDING")
  note             String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  agencyId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client    Tenant @relation("UpgradeClient", fields: [clientId], references: [id], onDelete: Cascade)
  applicant User   @relation("UpgradeApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([clientId])
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  role       String   @default("VIEWER")
  status     String   @default("ACTIVE")
  /// Branch PIC: the one outlet they work. Null for HQ / brand-wide roles.
  locationId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation("BranchStaff", fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([locationId])
}

/// Per-brand checkbox list of menus each client role may open.
model RoleMenuConfig {
  id        String   @id @default(cuid())
  tenantId  String
  role      String
  hrefsJson String
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role])
  @@index([tenantId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  objectType String?
  objectId   String?
  metaJson   String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model InboxNotice {
  id        String    @id @default(cuid())
  tenantId  String
  kind      String
  title     String
  body      String?
  href      String?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Immutable canonical store identity. atlasLocationId is never reused after archive.
model Location {
  id              String    @id @default(cuid())
  /// Immutable public ID — never change or reuse after archive
  atlasLocationId String    @unique
  tenantId        String
  name            String
  code            String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  country         String    @default("ID")
  phone           String?
  website         String?
  latitude        Float?
  longitude       Float?
  timezone        String    @default("Asia/Jakarta")
  /// STORE | HQ — HQ holds the brand Cloud API inbox (not a cashier outlet).
  kind            String    @default("STORE")
  /// Confirmed branch WhatsApp allowed to send loyalty intake to HQ.
  waOutletPhone     String?
  waOutletConfirmed Boolean @default(false)
  status          String    @default("ACTIVE")
  readiness       String    @default("DRAFT")
  readinessJson   String?
  notes           String?
  /// Public Review Capture token → GET /r/{token}. Null until staff open the link UI.
  reviewCaptureToken String?  @unique
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMemberships    Membership[]         @relation("BranchStaff")
  mappings            SourceMapping[]
  metricObservations  MetricObservation[]
  reviews             Review[]
  captureEvents       ReviewCaptureEvent[]
  waConversations     WaConversation[]
  loyaltyIntakes      LoyaltyIntake[]
  loyaltyStamps       LoyaltyStamp[]
  loyaltyRedeems      LoyaltyRedemption[]
  memberSignups       LoyaltyMember[]     @relation("MemberSignupLocation")
  loyaltyGoEvents     LoyaltyGoEvent[]
  commerceOutlets     CommerceProductOutlet[]
  commerceOrders      CommerceOrder[]
  wabaPhones          WabaPhone[]

  @@index([tenantId, status])
  @@index([tenantId, city])
  @@index([tenantId, readiness])
  @@index([tenantId, kind])
  @@unique([tenantId, code])
}

/// Google Business Profile (Maps) review — portfolio inbox (S7 foundation).
model Review {
  id              String    @id @default(cuid())
  locationId      String
  /// GBP: accounts/.../locations/.../reviews/...  Maps: maps:{id}
  externalId      String    @unique
  /// GOOGLE_BUSINESS_PROFILE | GOOGLE_MAPS
  sourceType      String    @default("GOOGLE_BUSINESS_PROFILE")
  reviewerName    String?
  starRating      Int
  comment         String?
  createTime      DateTime?
  updateTime      DateTime?
  /// Google-published owner reply text (if any)
  replyComment    String?
  replyUpdateTime DateTime?
  rawJson         String?
  lastSyncedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  location Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  drafts   ReviewReplyDraft[]

  @@index([locationId, updateTime])
  @@index([locationId, sourceType])
  @@index([starRating])
}

/// Guest opened the Review Capture link (intent). No customer PII required.
model ReviewCaptureEvent {
  id          String   @id @default(cuid())
  locationId  String
  token       String
  eventType   String   @default("opened")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  deviceType  String?
  createdAt   DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, createdAt])
  @@index([token, createdAt])
}

/// Local draft / approve / publish workflow for review replies (one page inbox).
model ReviewReplyDraft {
  id          String    @id @default(cuid())
  reviewId    String
  body        String
  /// DRAFT | PENDING_APPROVAL | PUBLISHED | FAILED | DISCARDED
  status      String    @default("DRAFT")
  authorId    String?
  publishedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
}

/// External system IDs mapped to atlas_location_id (one active external ID per source globally).
model SourceMapping {
  id              String   @id @default(cuid())
  locationId      String
  sourceType      String
  externalId      String
  externalLabel   String?
  confidence      String   @default("HIGH")
  status          String   @default("ACTIVE")
  metaJson        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([sourceType, externalId])
  @@index([locationId])
  @@index([sourceType, status])
}

/// External data connector (Google Business Profile, GSC, etc.). Agency OAuth uses AGENCY tenant.
model Connector {
  id               String    @id @default(cuid())
  tenantId         String
  /// GOOGLE_BUSINESS_PROFILE | GSC | ADS | WAHA | MANUAL
  provider         String
  status           String    @default("DISCONNECTED")
  displayName      String?
  accountEmail     String?
  accessTokenEnc   String?
  refreshTokenEnc  String?
  tokenExpiresAt   DateTime?
  scopes           String?
  lastSyncAt       DateTime?
  lastError        String?
  /// MOCK | LIVE
  mode             String    @default("LIVE")
  metaJson         String?
  /// Empty for one-row providers. WhatsApp Cloud uses the phone number id.
  accountKey       String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncRuns        SyncRun[]
  remoteLocations GoogleRemoteLocation[]

  @@unique([tenantId, provider, accountKey])
  @@index([provider, status])
  @@index([provider, accountKey])
}

model SyncRun {
  id          String    @id @default(cuid())
  connectorId String
  kind        String    @default("LIST_LOCATIONS")
  status      String    @default("RUNNING")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  statsJson   String?
  error       String?

  connector          Connector            @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  metricObservations MetricObservation[]

  @@index([connectorId, startedAt])
}

/// Cached Google Business Profile locations from list API / mock fixture.
model GoogleRemoteLocation {
  id               String   @id @default(cuid())
  connectorId      String
  externalId       String
  title            String
  storeCode        String?
  addressLine      String?
  locality         String?
  administrativeArea String?
  postalCode       String?
  regionCode       String?
  phone            String?
  website          String?
  rawJson          String?
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@index([connectorId])
  @@index([locality])
}

model BrandingConfig {
  id                    String   @id @default("default")
  appName               String   @default("AtlasNow")
  logoUrl               String?
  logoLetter            String   @default("A")
  tagline               String
  heroHeadline          String
  supportingNarrative   String
  productPromise        String
  flowStepsJson         String
  taglineId             String?
  heroHeadlineId        String?
  supportingNarrativeId String?
  productPromiseId      String?
  flowStepsJsonId       String?
  supportEmail          String?
  primaryColor          String   @default("#4f46e5")
  updatedAt             DateTime @updatedAt
}

/// Daily (or period) metric grain per atlas location — S4 MetricObservation store.
/// valueJson: { "value": number } | { "status": "NO_DATA"|"THRESHOLD"|"ERROR", "threshold"?: number, "message"?: string }
model MetricObservation {
  id             String   @id @default(cuid())
  locationId     String
  /// GBP Performance enum e.g. CALL_CLICKS, BUSINESS_DIRECTION_REQUESTS
  metricKey      String
  /// GBP_PERFORMANCE | GSC | ADS | WAHA | MANUAL | ATLAS_CALCULATED
  sourceSystem   String   @default("GBP_PERFORMANCE")
  /// Calendar day in location timezone (date-only stored as UTC midnight of that day)
  observedOn     DateTime
  valueJson      String
  timezone       String   @default("Asia/Jakarta")
  syncRunId      String?
  rawExpiresAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  syncRun  SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([locationId, metricKey, sourceSystem, observedOn])
  @@index([locationId, observedOn])
  @@index([metricKey, observedOn])
  @@index([sourceSystem, observedOn])
}

/// AtlasNow PAYG fee on WhatsApp broadcast. Singleton id=default.
/// Atlas each = flat IDR + marginPct% of Meta's per-message rate.
model BroadcastFeeConfig {
  id                String   @id @default("default")
  sessionIdr        Float    @default(0)
  marketingIdr      Float    @default(150)
  utilityIdr        Float    @default(90)
  authenticationIdr Float    @default(90)
  /// Percent of Meta rate, added on top of the flat fee. 25 = +25%.
  marginPct         Float    @default(0)
  updatedAt         DateTime @updatedAt
}

/// Central API / integration credentials & mode (Settings → API Configuration).
/// Secrets stored AES-GCM encrypted (AUTH_SECRET). Non-secret fields in publicJson.
model IntegrationConfig {
  /// Catalog key e.g. google_business_profile, google_maps, waha
  provider     String   @id
  /// OFF | MOCK | LIVE | AUTO (AUTO = prefer LIVE if credentials, else MOCK/OFF)
  mode         String   @default("AUTO")
  enabled      Boolean  @default(true)
  displayName  String?
  /// Non-secret settings (client id, base URL, region…)
  publicJson   String   @default("{}")
  /// Encrypted JSON blob of secrets (client secret, API keys, tokens…)
  secretsEnc   String?
  notes        String?
  lastError    String?
  lastCheckedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Founder-facing error log (Settings → Error log). Errors only.
model AppErrorLog {
  id        String   @id @default(cuid())
  source    String
  title     String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Brand loyalty program (stamp card and/or monthly top spender).
model LoyaltyProgram {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  stampEnabled       Boolean  @default(false)
  stampGoal          Int      @default(10)
  stampMinAmount     Int      @default(0)
  stampRewardText    String   @default("")
  /// [{ "stamps": 5, "reward": "Gratis es kopi" }, ...]
  stampTiersJson     String   @default("[]")
  /// lifetime | years_1 | years_2
  stampExpiry        String   @default("lifetime")
  /// Exclusive with stamp and top spender on Save.
  pointEnabled       Boolean  @default(false)
  /// Every Rp unitRupiah → pointPerUnit points (remainder discarded).
  pointUnitRupiah    Int      @default(100000)
  pointPerUnit       Int      @default(1000)
  /// [{ "points": 5000, "reward": "Tumbler" }, ...]
  pointTiersJson     String   @default("[]")
  spenderEnabled     Boolean  @default(false)
  /// BRAND | LOCATION
  spenderScope       String   @default("BRAND")
  spenderLocationId  String?
  spenderMinAmount   Int      @default(0)
  spenderTopN        Int      @default(1)
  spenderRewardText  String   @default("")
  /// [{ "rank": 1, "reward": "Voucher 200rb" }, ...]
  spenderTiersJson   String   @default("[]")
  /// Public token for /join/{joinKey}
  joinKey            String   @unique @default(cuid())
  /// BRAND | LOCATION
  qrScope            String   @default("BRAND")
  birthdayEnabled    Boolean  @default(false)
  birthdayRewardText String   @default("")
  /// Letters/numbers only. New WA codes: PREFIX + optional YY + - + random.
  birthdayVoucherPrefix    String  @default("BDY")
  birthdayVoucherYear      Boolean @default(true)
  birthdayVoucherSuffixLen Int     @default(4)
  /// JSON HQ WhatsApp auto-replies (Status Stamp, etc.). Empty keys use defaults.
  waRepliesJson      String   @default("{}")
  /// Merchant stamp-card artwork (JPEG/PNG). Overlay is count/goal only.
  stampCardImage     Bytes?
  stampCardMime      String   @default("")
  /// When true, even OCR MATCH waits for HQ Approve.
  receiptAuditMode   Boolean  @default(false)
  /// Tamu boleh kirim struk dari kartu stamp (/c/...).
  guestReceiptUpload Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Brand member from QR/form. Status calon/aktif is derived from approved receipts.
model LoyaltyMember {
  id                 String    @id @default(cuid())
  tenantId           String
  phone              String
  name               String    @default("")
  email              String    @default("")
  /// YYYY-MM-DD
  birthDate          String?
  /// Indonesia domicile (phone +62 / 08). Kota or kabupaten name.
  city               String    @default("")
  province           String    @default("")
  birthdayWaOptIn    Boolean   @default(false)
  birthdayWaOptInAt  DateTime?
  signupLocationId   String?
  /// QR | QR_OUTLET | STAFF
  source             String    @default("QR")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signupLocation Location? @relation("MemberSignupLocation", fields: [signupLocationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, phone])
  @@index([tenantId, createdAt])
  @@index([tenantId, birthdayWaOptIn])
}

/// One H-2 birthday_greeting per member per calendar year (tenant TZ).
model LoyaltyBirthdayWaSend {
  id            String   @id @default(cuid())
  tenantId      String
  memberPhone   String
  periodKey     String
  templateName  String
  /// PENDING | SENT | FAILED
  status        String
  error         String   @default("")
  /// Shown to the member in WA and to kasir on lookup.
  voucherCode   String   @default("")
  voucherValue  String   @default("")
  sentAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberPhone, periodKey])
  @@index([tenantId, periodKey])
}

model LoyaltyIntake {
  id            String    @id @default(cuid())
  tenantId      String
  locationId    String
  phone         String
  trxId         String
  amount        Int?
  invoiceRef    String?
  source        String    @default("FORM")
  /// PENDING | APPROVED | REJECTED
  status        String    @default("PENDING")
  rejectReason  String?
  reviewedById  String?
  reviewedAt    DateTime?
  /// NONE | SENT | FAILED | SKIPPED
  notifyStatus  String    @default("NONE")
  notifyError   String?
  photoImage    Bytes?
  photoMime     String    @default("")
  /// raw OCR + extracted fields
  ocrJson       String    @default("")
  /// MATCH | MISMATCH | UNREADABLE | SKIPPED
  matchStatus   String    @default("SKIPPED")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stamps   LoyaltyStamp[]

  @@unique([tenantId, trxId])
  @@index([tenantId, status, createdAt])
  @@index([locationId, createdAt])
}

model LoyaltyStamp {
  id          String   @id @default(cuid())
  tenantId    String
  memberPhone String
  intakeId    String
  locationId  String
  amount      Int?
  stampedAt   DateTime @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  intake   LoyaltyIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberPhone, stampedAt])
}

model LoyaltyRedemption {
  id          String   @id @default(cuid())
  tenantId    String
  memberPhone String
  /// STAMP_CARD | TOP_SPENDER
  kind        String
  periodKey   String?
  /// stamp count ("5") or spender rank ("1"); empty = legacy single-reward redeem
  tierKey     String   @default("")
  /// true only when the highest stamp gift is claimed — starts a new card
  resetsCard  Boolean  @default(false)
  locationId  String?
  actorId     String?
  /// Birthday WA code the cashier typed. Empty for stamp / top spender.
  voucherCode String   @default("")
  redeemedAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId, memberPhone, kind])
  @@unique([tenantId, memberPhone, kind, periodKey, tierKey])
}

/// TikTok GO till: query / redeem / deny at an outlet. Not a stamp. Not GMV.
model LoyaltyGoEvent {
  id          String   @id @default(cuid())
  tenantId    String
  locationId  String
  /// QUERY | REDEEM | DENY
  kind        String
  demo        Boolean  @default(false)
  title       String
  detail      String   @default("")
  /// Short hint (TT-DEMO-OK), never the full QR payload.
  codeHint    String   @default("")
  shopOrderId String?
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, locationId, createdAt])
}

model WaContact {
  id                  String   @id @default(cuid())
  tenantId            String
  identifier          String
  displayName         String?
  identityConfidence  String
  phone               String?
  lid                 String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations WaConversation[]

  @@unique([tenantId, identifier])
  @@index([tenantId, phone])
  @@index([tenantId, lid])
}

model WaConversation {
  id              String    @id @default(cuid())
  tenantId        String
  locationId      String
  contactId       String
  provider        String    @default("WAHA")
  sessionId       String
  status          String    @default("OPEN")
  firstMessageAt  DateTime
  lastMessageAt   DateTime
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  lastPreview     String    @default("")
  /// HUMAN_ACTIVE while a person is handling this chat. Empty lets automation run.
  handoffState    String    @default("")
  /// Inactivity expiry for HUMAN_ACTIVE. Null means resume is explicit.
  handoffUntil    DateTime?
  /// Cloud business phone that received this chat. Empty on older rows; sessionId still has cloud:{id}.
  businessPhoneNumberId String @default("")
  /// Workspace user id when a person is assigned. Empty means unassigned.
  assignedUserId  String    @default("")
  /// Explicit lead status. Empty is not a lead and is not ad attribution.
  leadStatus      String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contact  WaContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages WaMessage[]

  @@index([tenantId, lastMessageAt])
  @@index([locationId, lastMessageAt])
  @@index([contactId, sessionId, status])
  @@index([tenantId, businessPhoneNumberId])
}

model WaMessage {
  id             String   @id @default(cuid())
  conversationId String
  externalId     String   @unique
  direction      String
  sentAt         DateTime
  body           String   @default("")
  fromMe         Boolean  @default(false)
  /// cloud, business_app, or history. Empty on rows written before coexistence.
  source         String   @default("")
  /// Meta referral object when the webhook included one. Empty means unknown, not an ad lead.
  referralJson   String   @default("")
  rawJson        String?
  /// Inbox image bytes. Already applied on production as 20261004120000 and 20261004143000.
  mediaImage     Bytes?
  mediaMime      String   @default("")
  inboxImage     Boolean  @default(false)
  mediaPurgedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

/// Public About / Contact copy — edited in Settings → Pages (agency).
model SitePageConfig {
  id                 String   @id @default("default")
  aboutHeadlineEn    String
  aboutBodyEn        String
  aboutPointsJsonEn  String
  aboutHeadlineId    String
  aboutBodyId        String
  aboutPointsJsonId  String
  contactHeadlineEn  String
  contactBodyEn      String
  contactHeadlineId  String
  contactBodyId      String
  contactNoteEn      String?
  contactNoteId      String?
  /// JSON { instagram, facebook, threads, tiktok, x }
  socialJson         String?
  /// JSON FaqItem[] — public /faq, edited in Settings → Pages
  faqJson            String?
  updatedAt          DateTime @updatedAt
}

/// Submissions from the public Contact page. Emails also go to hello@atlasnow.co.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  locale    String   @default("en")
  ipHash    String?
  mailSent  Boolean  @default(false)
  mailError String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

/// P2P support desk (Radit). Not WhatsApp. Not merchant-customer chat.
model SupportDeskSettings {
  id          String    @id @default("default")
  enabled     Boolean   @default(true)
  openHm      String    @default("09:00")
  closeHm     String    @default("17:00")
  daysOfWeek  String    @default("1,2,3,4,5,6,7")
  timezone    String    @default("Asia/Jakarta")
  agentSeenAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model SupportThread {
  id                String    @id @default(cuid())
  status            String    @default("QUEUED")
  visitorKind       String
  userId            String?
  tenantId          String?
  name              String
  email             String
  locale            String    @default("en")
  roleLabel         String    @default("")
  firstPath         String    @default("")
  lastPath          String    @default("")
  queuedAt          DateTime  @default(now())
  openedAt          DateTime?
  closedAt          DateTime?
  closeReason       String?
  lastVisitorAt     DateTime?
  lastAgentAt       DateTime?
  lastPreview       String    @default("")
  silenceDeadlineAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([status, queuedAt])
  @@index([email, status])
  @@index([userId, status])
}

model SupportMessage {
  id       String   @id @default(cuid())
  threadId String
  from     String
  body     String   @default("")
  sentAt   DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt])
}

/// HQ Cloud blast History. Not inbox. Not loyalty.
model BroadcastBatch {
  id              String   @id @default(cuid())
  tenantId        String
  createdByUserId String?
  kind            String
  templateName    String?
  attemptedCount  Int      @default(0)
  createdAt       DateTime @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  sends     BroadcastSend[]

  @@index([tenantId, createdAt])
}

model BroadcastSend {
  id               String    @id @default(cuid())
  batchId          String
  tenantId         String
  phone            String
  wamid            String?
  status           String    @default("PENDING")
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  failedAt         DateTime?
  errorCode        Int?
  errorTitle       String    @default("")
  pricingCategory  String?
  pricingType      String?
  repliedAt        DateTime?
  createdAt        DateTime  @default(now())

  batch  BroadcastBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([wamid])
  @@index([tenantId, phone, sentAt])
  @@index([batchId])
}

/// One Cloud business phone. Meta’s 1,000 free service msgs reset per this number, monthly.
model WabaPhone {
  id              String   @id @default(cuid())
  tenantId        String
  wabaId          String   @default("")
  phoneNumberId   String   @unique
  displayPhone    String   @default("")
  /// BRAND = Meta invoices the merchant. P2P = we pass through.
  billingOwner    String   @default("BRAND")
  timezone        String   @default("Asia/Jakarta")
  paymentMethodOk Boolean  @default(false)
  status          String   @default("ACTIVE")
  /// Staff label. Empty uses the display phone.
  alias           String   @default("")
  /// Optional outlet. Null serves the workspace without a branch assignment.
  locationId      String?
  /// Optional department or team label. Empty means no team filter.
  teamLabel       String   @default("")
  /// At most one default number per workspace. Sends that omit a phone use this number.
  isDefault       Boolean  @default(false)
  /// COEXISTENCE or CLOUD_API_ONLY when onboarding set it. Empty stays unset.
  connectionMode  String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location   Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  months     WabaServiceMonth[]
  deliveries WabaServiceDelivery[]

  @@index([tenantId])
  @@index([locationId])
}

/// Per-number automation override. A missing row does not turn automation on.
/// Null fields inherit workspace defaults only for the bound or sole default number.
model WhatsAppNumberAutomation {
  id                      String   @id @default(cuid())
  tenantId                String
  phoneNumberId           String
  inboundEnabled          Boolean?
  paymentFollowUpEnabled  Boolean?
  marketingEnabled        Boolean?
  pilotMode               Boolean?
  flowId                  String?
  flowScreen              String?
  flowCta                 String?
  inboundBody             String?
  triggerPhrases          String?
  paymentTriggerPhrases   String?
  paymentMessageText      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneNumberId])
  @@index([phoneNumberId])
}

/// Per-workspace commerce automation. Missing row means disabled.
/// A legacy YOLA env flag set to false still blocks that purpose.
/// Flow, triggers, and payment text are required before that purpose can send.
model WorkspaceAutomation {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  inboundEnabled         Boolean   @default(false)
  paymentFollowUpEnabled Boolean   @default(false)
  marketingEnabled       Boolean   @default(false)
  /// Set only by an explicit authorize action. The switch alone does not send.
  marketingAuthorizedAt  DateTime?
  /// Pilot mode does not send by itself. An empty allowlist sends to nobody.
  pilotMode              Boolean   @default(true)
  flowId                 String?
  flowScreen             String?
  flowCta                String?
  inboundBody            String?
  triggerPhrases         String?
  paymentTriggerPhrases  String?
  paymentMessageText     String?
  /// Bound from this workspace's WhatsApp connector. A mismatch does not send.
  phoneNumberId          String?
  wabaId                 String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant    Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allowlist WorkspaceAutomationAllowlist[]
  audits    WorkspaceAutomationAudit[]
  outbounds WorkspaceAutomationOutbound[]
}

model WorkspaceAutomationAllowlist {
  id        String   @id @default(cuid())
  tenantId  String
  digits    String
  createdAt DateTime @default(now())

  automation WorkspaceAutomation @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, digits])
  @@index([tenantId])
}

model WorkspaceAutomationAudit {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  summary     String
  createdAt   DateTime @default(now())

  automation WorkspaceAutomation @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// At most one outbound attempt per dedupe key. A replay does not send again.
model WorkspaceAutomationOutbound {
  id            String   @id @default(cuid())
  tenantId      String
  dedupeKey     String   @unique
  purpose       String
  status        String
  phoneNumberId String
  toDigits      String
  detail        String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  automation WorkspaceAutomation @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model WabaServiceMonth {
  id            String @id @default(cuid())
  phoneNumberId String
  /// YYYY-MM in that phone’s timezone (resets 00:00 on the 1st)
  periodKey     String
  serviceCount  Int    @default(0)
  freeCap       Int    @default(1000)

  phone WabaPhone @relation(fields: [phoneNumberId], references: [phoneNumberId], onDelete: Cascade)

  @@unique([phoneNumberId, periodKey])
}

/// Idempotent delivered-service count. Retry is not a second gift.
model WabaServiceDelivery {
  id            String   @id @default(cuid())
  phoneNumberId String
  periodKey     String
  wamid         String   @unique
  createdAt     DateTime @default(now())

  phone WabaPhone @relation(fields: [phoneNumberId], references: [phoneNumberId], onDelete: Cascade)

  @@index([phoneNumberId, periodKey])
}

/// What we sent, so we can count session replies before Meta tags category=service.
model WabaOutbound {
  wamid         String   @id
  phoneNumberId String
  tenantId      String
  /// session | template
  kind          String
  createdAt     DateTime @default(now())

  @@index([phoneNumberId])
}

/// Merchant product master. AtlasNow is the source of truth. Not a Meta catalog row.
/// Price is whole IDR. Catalog eligibility is not availability and is not a sale.
model CommerceProduct {
  id                     String    @id @default(cuid())
  tenantId               String
  sku                    String
  name                   String
  description            String    @default("")
  category               String    @default("")
  imageUrl               String?
  /// Uploaded product photo. Not returned in list queries.
  imageData              Bytes?
  imageMime              String    @default("")
  /// Whole rupiah. Not cents.
  unitPriceIdr           Int
  /// Optional https product page. Empty until the merchant saves one.
  /// The live sync route does not read this. The feed file and the publish preview do.
  publicUrl              String    @default("")
  /// ACTIVE | ARCHIVED
  status                 String    @default("ACTIVE")
  /// AVAILABLE | UNAVAILABLE — internal offer state. Not catalog eligibility.
  availability           String    @default("AVAILABLE")
  /// UNKNOWN | INELIGIBLE. This slice never stores ELIGIBLE.
  catalogEligibility     String    @default("UNKNOWN")
  catalogEligibilityNote String    @default("")
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants    CommerceVariant[]
  outlets     CommerceProductOutlet[]
  catalogLink CommerceCatalogLink?
  variantMaps CommerceVariantMap[]
  syncLogs    CommerceSyncLog[]
  syncJobs    CommerceSyncJob[]
  orderLines  CommerceOrderLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
}

model CommerceVariant {
  id           String   @id @default(cuid())
  tenantId     String
  productId    String
  sku          String
  name         String
  /// Null inherits the product price.
  unitPriceIdr Int?
  /// ACTIVE | ARCHIVED
  status       String   @default("ACTIVE")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product CommerceProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogMap CommerceVariantMap?
  orderLines CommerceOrderLine[]

  @@unique([tenantId, sku])
  @@index([productId])
}

/// Outlet assignment. A product with no rows is not offered at any outlet.
model CommerceProductOutlet {
  id           String   @id @default(cuid())
  tenantId     String
  productId    String
  locationId   String
  /// AVAILABLE | UNAVAILABLE
  availability String   @default("AVAILABLE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([tenantId, locationId])
}

/// Product-level Meta catalog mapping. retailerId is the AtlasNow SKU.
/// reviewStatus is Meta's review, not the internal offer status.
model CommerceCatalogLink {
  id                String    @id @default(cuid())
  tenantId          String
  productId         String    @unique
  externalProductId String    @default("")
  externalCatalogId String    @default("")
  /// Graph product id. Empty until Meta returns one.
  metaProductId     String    @default("")
  retailerId        String
  /// NOT_CONNECTED | BLOCKED | PREVIEWED | PENDING | SUBMITTED | PROCESSING | SYNCED | FAILED | OUTDATED | IMPORTED
  syncStatus        String    @default("NOT_CONNECTED")
  /// UNKNOWN | PENDING | APPROVED | REJECTED. Never copied from availability or from batch acceptance.
  reviewStatus      String    @default("UNKNOWN")
  /// Hash of the last batch Meta finished with no item errors. Empty until processing is confirmed.
  processedPayloadHash String @default("")
  /// Public product URL included in that confirmed payload.
  processedPublicUrl   String @default("")
  /// False when the stored Meta ids belong to a catalog that is no longer selected.
  mappingCurrent       Boolean @default(true)
  lastError         String    @default("")
  lastAttemptAt     DateTime?
  /// Set when a Meta item is copied into the product master. Not a catalog push.
  lastImportedAt    DateTime?
  /// JSON fields copied from Meta at import. Product edits do not change it.
  sourceSnapshot    String    @default("")
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, retailerId])
  @@index([tenantId, syncStatus])
}

/// Variant SKU mapped to its own Meta catalog item. One retailer id per merchant.
model CommerceVariantMap {
  id                String    @id @default(cuid())
  tenantId          String
  productId         String
  variantId         String    @unique
  retailerId        String
  externalProductId String    @default("")
  metaProductId     String    @default("")
  syncStatus        String    @default("NOT_CONNECTED")
  reviewStatus      String    @default("UNKNOWN")
  /// False when the stored Meta ids belong to a catalog that is no longer selected.
  mappingCurrent    Boolean   @default(true)
  lastError         String    @default("")
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product CommerceProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant CommerceVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, retailerId])
  @@index([productId])
}

model CommerceSyncLog {
  id        String   @id @default(cuid())
  tenantId  String
  productId String?
  action    String
  outcome   String
  message   String
  createdAt DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product CommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

/// Merchant Meta catalog connection. The access token stays encrypted and is never sent to the browser.
model CommerceConnection {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  businessId      String    @default("")
  businessName    String    @default("")
  wabaId          String    @default("")
  phoneNumberId   String    @default("")
  phoneMasked     String    @default("")
  catalogId       String    @default("")
  catalogName     String    @default("")
  /// Meta catalog vertical from Find catalogs. Empty until that read returns one.
  catalogVertical String    @default("")
  /// Comma-separated scope names returned by Meta. Not a token.
  grantedScopes   String    @default("")
  tokenEnc        String?
  tokenExpiresAt  DateTime?
  lastError       String    @default("")
  permissionError Boolean   @default(false)
  lastCheckedAt   DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// One row per merchant + payload. A repeated sync returns this row instead of sending twice.
model CommerceSyncJob {
  id             String    @id @default(cuid())
  tenantId       String
  productId      String?
  idempotencyKey String
  action         String
  /// BLOCKED | SUBMITTED | PROCESSING | SUCCEEDED | FAILED
  status         String
  attempts       Int       @default(0)
  lastError      String    @default("")
  payloadHash    String    @default("")
  /// Meta catalog batch handle. Empty until Graph accepts the batch.
  batchHandle    String    @default("")
  /// Per-item validation JSON. Never a token.
  itemResults    String    @default("")
  /// Catalog the batch was sent to. Compared again before a result is applied.
  catalogId      String    @default("")
  /// Public URL included in that batch.
  publicUrl      String    @default("")
  pollAttempts   Int       @default(0)
  nextPollAt     DateTime?
  lockedAt       DateTime?
  /// Worker claim. Empty when the job is free.
  lockToken      String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product CommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([status, nextPollAt])
}

/// One-time commerce OAuth nonce. Bound to the session that started the login. The value is not a Meta token.
model CommerceOAuthNonce {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  nonce      String
  sessionKey String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, nonce])
  @@index([expiresAt])
}

/// Payment flags only. Checkout stays off. This row is not a Meta connection.
model CommerceReadiness {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  whatsappStatus       String   @default("NOT_CONNECTED")
  catalogStatus        String   @default("NOT_CONNECTED")
  paymentStatus        String   @default("NOT_CONNECTED")
  paymentProviderLabel String   @default("")
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Inbound WhatsApp catalog order. Not a payment, a ticket, or revenue.
/// customerWaId is the sender. Do not write it to logs or the orders list.
model CommerceOrder {
  id             String   @id @default(cuid())
  tenantId       String
  locationId     String?
  reference      String
  /// PENDING_PAYMENT. This slice does not move it.
  status         String   @default("PENDING_PAYMENT")
  /// MATCHED | UNKNOWN_SKU | PRICE_MISMATCH | REVIEW
  validation     String
  paymentStatus  String   @default("NOT_INITIATED")
  source         String   @default("WHATSAPP_ORDER")
  wabaId         String
  phoneNumberId  String
  catalogId      String
  waMessageId    String   @unique
  customerWaId   String
  /// Masked sender. Last four digits only.
  customerRef    String
  currency       String   @default("")
  /// Sum of WhatsApp item prices. Not revenue.
  estimatedTotal Int?
  /// Product-master total. Set only when every line matches. Not the WhatsApp total.
  masterTotalIdr Int?
  receivedAt     DateTime
  createdAt      DateTime @default(now())

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  lines    CommerceOrderLine[]

  @@unique([tenantId, reference])
  @@index([tenantId, receivedAt])
}

model CommerceOrderLine {
  id                 String @id @default(cuid())
  tenantId           String
  orderId            String
  sku                String
  quantity           Int
  currency           String @default("")
  /// WhatsApp item price when it is a whole number. Not revenue.
  itemPriceEstimate  Int?
  masterUnitPriceIdr Int?
  productId          String?
  variantId          String?
  /// MATCHED | UNKNOWN_SKU | PRICE_MISMATCH | REVIEW
  validation         String

  order   CommerceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product CommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant CommerceVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
}

/// YOLA FUN presale. Rows belong to the tenant that owns the configured WhatsApp phone.
/// Phone numbers stay off the admin list. Sandbox payment is not revenue.

model YolaCustomer {
  id            String    @id @default(cuid())
  tenantId      String
  waId          String
  phoneE164     String    @default("")
  name          String    @default("")
  optedOut      Boolean   @default(false)
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions YolaFlowSession[]
  orders   YolaOrder[]

  @@unique([tenantId, waId])
  @@index([tenantId])
}

model YolaFlowSession {
  id            String    @id @default(cuid())
  tenantId      String
  customerId    String
  waId          String
  flowToken     String
  status        String    @default("invited")
  source        String    @default("direct")
  phoneNumberId String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer YolaCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   YolaOrder[]

  @@unique([tenantId, flowToken])
  @@index([tenantId, waId, status])
}

model YolaOrder {
  id             String   @id @default(cuid())
  tenantId       String
  humanId        String
  customerId     String
  sessionId      String?
  waId           String
  wamid          String
  flowToken      String
  buyerName      String
  buyerPhoneE164 String
  phoneMismatch  Boolean  @default(false)
  visitDate      String
  visitTime      String
  amountIdr      Int
  currency       String   @default("IDR")
  status         String   @default("PENDING_PAYMENT")
  /// synthetic | pilot | unspecified. Simulated payment does not change this.
  origin         String   @default("unspecified")
  preferenceNote String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer YolaCustomer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session  YolaFlowSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  payments YolaPaymentSession[]
  events   YolaPaymentEvent[]
  tickets  YolaTicket[]

  @@unique([tenantId, humanId])
  @@unique([tenantId, wamid])
  @@unique([tenantId, flowToken])
  @@index([tenantId, createdAt])
}

model YolaPaymentSession {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  provider    String   @default("sandbox")
  mode        String   @default("sandbox")
  status      String   @default("PENDING")
  amountIdr   Int
  currency    String   @default("IDR")
  nonceHash   String
  providerRef String   @default("")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  YolaOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
}

model YolaPaymentEvent {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  eventId   String
  provider  String
  outcome   String
  amountIdr Int
  currency  String   @default("IDR")
  live      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  YolaOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([orderId])
}

model YolaTicket {
  id           String   @id @default(cuid())
  tenantId     String
  orderId      String   @unique
  publicId     String
  tokenHash    String   @unique
  remaining    Int      @default(2)
  issuanceMode String   @default("TEST")
  validFrom    String
  validUntil   String
  createdAt    DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       YolaOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  redemptions YolaRedemption[]

  @@unique([tenantId, publicId])
  @@index([tenantId])
}

model YolaRedemption {
  id             String   @id @default(cuid())
  tenantId       String
  ticketId       String
  idempotencyKey String
  result         String
  remainingAfter Int
  createdAt      DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket YolaTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, idempotencyKey])
  @@index([tenantId])
}

model YolaAutomationEvent {
  id        String   @id @default(cuid())
  tenantId  String
  kind      String
  dedupeKey String
  detail    String   @default("")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, createdAt])
}

model YolaOutboundMessage {
  id             String   @id @default(cuid())
  tenantId       String
  waId           String
  kind           String
  status         String   @default("held")
  body           String   @default("")
  payloadJson    String   @default("")
  providerWamid  String   @default("")
  deliveryStatus String   @default("")
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, waId, createdAt])
  @@index([providerWamid])
}

/// Daily human order sequence. Asia/Jakarta day key. Not a customer-facing id by itself.
model YolaOrderDaySeq {
  id       String @id @default(cuid())
  tenantId String
  dayKey   String
  next     Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayKey])
}
