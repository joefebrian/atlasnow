// AtlasNow — agency admin + clients + location master (S2) + branding

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// TenantType: AGENCY | CLIENT
// TenantStatus: ACTIVE | INACTIVE | ARCHIVED
// LocationStatus: ACTIVE | INACTIVE | ARCHIVED
// LocationReadiness: DRAFT | PARTIAL | READY | MAPPED | BLOCKED
// SourceType: GOOGLE_BUSINESS_PROFILE | GSC | ADS | WAHA | SOCIAL | REDEMPTION | MANUAL
// Role: SUPER_ADMIN | ANALYST | CLIENT_ADMIN | HQ_MARKETING | HQ_OPS | REGIONAL | BRANCH | VIEWER
// MembershipStatus: ACTIVE | INVITED | DISABLED

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[] @relation("AuditActor")
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  type         String   @default("CLIENT")
  timezone     String   @default("Asia/Jakarta")
  status       String   @default("ACTIVE")
  loginEnabled Boolean  @default(false)
  industry     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?
  address      String?
  notes        String?
  activatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[]
  locations   Location[]
  connectors  Connector[]
  waContacts      WaContact[]
  waConversations WaConversation[]

  @@index([type, status])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("VIEWER")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  objectType String?
  objectId   String?
  metaJson   String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

/// Immutable canonical store identity. atlasLocationId is never reused after archive.
model Location {
  id              String    @id @default(cuid())
  /// Immutable public ID — never change or reuse after archive
  atlasLocationId String    @unique
  tenantId        String
  name            String
  code            String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  country         String    @default("ID")
  phone           String?
  website         String?
  latitude        Float?
  longitude       Float?
  timezone        String    @default("Asia/Jakarta")
  status          String    @default("ACTIVE")
  readiness       String    @default("DRAFT")
  readinessJson   String?
  notes           String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mappings            SourceMapping[]
  metricObservations  MetricObservation[]
  reviews             Review[]
  waConversations     WaConversation[]

  @@index([tenantId, status])
  @@index([tenantId, city])
  @@index([tenantId, readiness])
  @@unique([tenantId, code])
}

/// Google Business Profile (Maps) review — portfolio inbox (S7 foundation).
model Review {
  id              String    @id @default(cuid())
  locationId      String
  /// Google resource name accounts/.../locations/.../reviews/...
  externalId      String    @unique
  reviewerName    String?
  starRating      Int
  comment         String?
  createTime      DateTime?
  updateTime      DateTime?
  /// Google-published owner reply text (if any)
  replyComment    String?
  replyUpdateTime DateTime?
  rawJson         String?
  lastSyncedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  location Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  drafts   ReviewReplyDraft[]

  @@index([locationId, updateTime])
  @@index([starRating])
}

/// Local draft / approve / publish workflow for review replies (one page inbox).
model ReviewReplyDraft {
  id          String    @id @default(cuid())
  reviewId    String
  body        String
  /// DRAFT | PENDING_APPROVAL | PUBLISHED | FAILED | DISCARDED
  status      String    @default("DRAFT")
  authorId    String?
  publishedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
}

/// External system IDs mapped to atlas_location_id (one active external ID per source globally).
model SourceMapping {
  id              String   @id @default(cuid())
  locationId      String
  sourceType      String
  externalId      String
  externalLabel   String?
  confidence      String   @default("HIGH")
  status          String   @default("ACTIVE")
  metaJson        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([sourceType, externalId])
  @@index([locationId])
  @@index([sourceType, status])
}

/// External data connector (Google Business Profile, GSC, etc.). Agency OAuth uses AGENCY tenant.
model Connector {
  id               String    @id @default(cuid())
  tenantId         String
  /// GOOGLE_BUSINESS_PROFILE | GSC | ADS | WAHA | MANUAL
  provider         String
  status           String    @default("DISCONNECTED")
  displayName      String?
  accountEmail     String?
  accessTokenEnc   String?
  refreshTokenEnc  String?
  tokenExpiresAt   DateTime?
  scopes           String?
  lastSyncAt       DateTime?
  lastError        String?
  /// MOCK | LIVE
  mode             String    @default("LIVE")
  metaJson         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncRuns        SyncRun[]
  remoteLocations GoogleRemoteLocation[]

  @@unique([tenantId, provider])
  @@index([provider, status])
}

model SyncRun {
  id          String    @id @default(cuid())
  connectorId String
  kind        String    @default("LIST_LOCATIONS")
  status      String    @default("RUNNING")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  statsJson   String?
  error       String?

  connector          Connector            @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  metricObservations MetricObservation[]

  @@index([connectorId, startedAt])
}

/// Cached Google Business Profile locations from list API / mock fixture.
model GoogleRemoteLocation {
  id               String   @id @default(cuid())
  connectorId      String
  externalId       String
  title            String
  storeCode        String?
  addressLine      String?
  locality         String?
  administrativeArea String?
  postalCode       String?
  regionCode       String?
  phone            String?
  website          String?
  rawJson          String?
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@index([connectorId])
  @@index([locality])
}

model BrandingConfig {
  id                    String   @id @default("default")
  appName               String   @default("AtlasNow")
  logoUrl               String?
  logoLetter            String   @default("A")
  tagline               String
  heroHeadline          String
  supportingNarrative   String
  productPromise        String
  flowStepsJson         String
  taglineId             String?
  heroHeadlineId        String?
  supportingNarrativeId String?
  productPromiseId      String?
  flowStepsJsonId       String?
  supportEmail          String?
  primaryColor          String   @default("#4f46e5")
  updatedAt             DateTime @updatedAt
}

/// Daily (or period) metric grain per atlas location — S4 MetricObservation store.
/// valueJson: { "value": number } | { "status": "NO_DATA"|"THRESHOLD"|"ERROR", "threshold"?: number, "message"?: string }
model MetricObservation {
  id             String   @id @default(cuid())
  locationId     String
  /// GBP Performance enum e.g. CALL_CLICKS, BUSINESS_DIRECTION_REQUESTS
  metricKey      String
  /// GBP_PERFORMANCE | GSC | ADS | WAHA | MANUAL | ATLAS_CALCULATED
  sourceSystem   String   @default("GBP_PERFORMANCE")
  /// Calendar day in location timezone (date-only stored as UTC midnight of that day)
  observedOn     DateTime
  valueJson      String
  timezone       String   @default("Asia/Jakarta")
  syncRunId      String?
  rawExpiresAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  syncRun  SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([locationId, metricKey, sourceSystem, observedOn])
  @@index([locationId, observedOn])
  @@index([metricKey, observedOn])
  @@index([sourceSystem, observedOn])
}

/// Central API / integration credentials & mode (Settings → API Configuration).
/// Secrets stored AES-GCM encrypted (AUTH_SECRET). Non-secret fields in publicJson.
model IntegrationConfig {
  /// Catalog key e.g. google_business_profile, google_maps, waha
  provider     String   @id
  /// OFF | MOCK | LIVE | AUTO (AUTO = prefer LIVE if credentials, else MOCK/OFF)
  mode         String   @default("AUTO")
  enabled      Boolean  @default(true)
  displayName  String?
  /// Non-secret settings (client id, base URL, region…)
  publicJson   String   @default("{}")
  /// Encrypted JSON blob of secrets (client secret, API keys, tokens…)
  secretsEnc   String?
  notes        String?
  lastError    String?
  lastCheckedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WaContact {
  id                  String   @id @default(cuid())
  tenantId            String
  identifier          String
  displayName         String?
  identityConfidence  String
  phone               String?
  lid                 String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations WaConversation[]

  @@unique([tenantId, identifier])
  @@index([tenantId, phone])
  @@index([tenantId, lid])
}

model WaConversation {
  id              String    @id @default(cuid())
  tenantId        String
  locationId      String
  contactId       String
  provider        String    @default("WAHA")
  sessionId       String
  status          String    @default("OPEN")
  firstMessageAt  DateTime
  lastMessageAt   DateTime
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  lastPreview     String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contact  WaContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages WaMessage[]

  @@index([tenantId, lastMessageAt])
  @@index([locationId, lastMessageAt])
  @@index([contactId, sessionId, status])
}

model WaMessage {
  id             String   @id @default(cuid())
  conversationId String
  externalId     String   @unique
  direction      String
  sentAt         DateTime
  body           String   @default("")
  fromMe         Boolean  @default(false)
  rawJson        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}
